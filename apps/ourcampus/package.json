{
  "name": "campus-twin-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ai:serve": "node --env-file=.env.local scripts/serve-auv.mjs",
    "build": "vite build",
    "build:pages": "npm run build && node scripts/prepare-pages.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:share": "node scripts/serve-android-apk.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.3",
    "@supabase/supabase-js": "^2.117.2",
    "@vitejs/plugin-react": "^6.0.1",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.186.0",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "vitest": "^4.0.18"
  }
}
