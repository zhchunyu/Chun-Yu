# ---- 三维资产：产物可重生成，源文件与导入件必须保留 ----
/archive/3d-research/cad/STEP/*
!/archive/3d-research/cad/STEP/imported/
/archive/3d-research/cad/DXF/*
!/archive/3d-research/cad/DXF/imported/
/archive/3d-research/cad/STL/*
!/archive/3d-research/cad/STL/imported/
/archive/3d-research/cad/GLB/*
!/archive/3d-research/cad/GLB/imported/
/archive/3d-research/cad/3MF/*
!/archive/3d-research/cad/3MF/imported/
/archive/3d-research/cad/tmp/

# Blender 自动备份与缓存
*.blend1
*.blend2
__pycache__/
*.pyc

# 临时与系统
/99-临时工作区/
.DS_Store
Thumbs.db

# 依赖与构建
node_modules/
dist/
build/
.venv/
venv/
.env
.env.local

# 大文件与媒体（按需开启 LFS 或手动管理）
*.psd
*.mp4

# ---- 单张成图不入库：仓库只留图集（建模图集 HTML）与站点，不存单张 PNG ----
# 说明：02-三维资产/renders/ 已有 64 张在库中（历史提交），此处不追加以免歧义；
#       新增归档目录一律不入库，只把汇总图集放进去。
/archive/deliverables/renders_*/

# ---- 临时探针工程与素材 ----
/archive/3d-research/blender/projects/_tmp_*.blend
/archive/3d-research/99-临时工作区/

# .blend 工程文件走 GitHub Release（tag: blend-projects）分发，不入仓库树 —— 单文件 40~90 MB，
# 远超 GitHub API 的 blob 单请求体积上限（实测约 36 MB）。放在这里可避免误提交。
/archive/3d-research/blender/projects/*.blend

# ---- 工具产物与外部素材 ----
/.trae-html-share-packages/
/picture/

# ---- 合规：去标识黑名单（含校名，禁止入库/外发）----
.identifier_blacklist.txt
**/.identifier_blacklist.txt

# ---- 本机分析产物与本机工具（不入库）----
# POI / OCR 采集与标定的中间数据
/.pois.json
/.poi-harvest.json
/.poi-hits.json
/.plan-ocr.json
/.plan-ocr-tiled.json
/.osm-campus.json
/.affine-refit.json
# 本机预览与下载辅助脚本、验证截图
/OurCampus-手机预览.cmd
/start-ourcampus-preview.ps1
/download-blend-release.ps1
/OurCampus-预览截图-*.png
# 内部核验文档（含真实名称对照，仅供本机人工核验，禁止随提交物打包）
/项目分析报告.md
/地名替换清单.md
/腾讯地图地名核验清单.md
/提交打包排除清单.md
