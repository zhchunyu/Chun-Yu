# ---- 三维资产：产物可重生成，源文件与导入件必须保留 ----
/02-三维资产/cad/STEP/*
!/02-三维资产/cad/STEP/imported/
/02-三维资产/cad/DXF/*
!/02-三维资产/cad/DXF/imported/
/02-三维资产/cad/STL/*
!/02-三维资产/cad/STL/imported/
/02-三维资产/cad/GLB/*
!/02-三维资产/cad/GLB/imported/
/02-三维资产/cad/3MF/*
!/02-三维资产/cad/3MF/imported/
/02-三维资产/cad/tmp/

# Blender 自动备份与缓存
*.blend1
*.blend2
__pycache__/
*.pyc

# 临时与系统
/99-临时工作区/
.DS_Store
Thumbs.db

# 依赖与构建
node_modules/
dist/
build/
.venv/
venv/
.env
.env.local

# 大文件与媒体（按需开启 LFS 或手动管理）
*.psd
*.mp4

# ---- 单张成图不入库：仓库只留图集（建模图集 HTML）与站点，不存单张 PNG ----
# 说明：02-三维资产/renders/ 已有 64 张在库中（历史提交），此处不追加以免歧义；
#       新增归档目录一律不入库，只把汇总图集放进去。
/08-交付与归档/renders_*/

# ---- 临时探针工程与素材 ----
/02-三维资产/blender/projects/_tmp_*.blend
/02-三维资产/99-临时工作区/

